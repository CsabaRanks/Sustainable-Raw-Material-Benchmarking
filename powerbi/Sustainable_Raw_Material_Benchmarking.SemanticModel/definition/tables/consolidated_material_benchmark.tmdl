table consolidated_material_benchmark
	lineageTag: b4eb6f8c-f5fd-487c-b566-c576aaf8be78

	measure 'Annual Spend (EUR)' = SUM ( consolidated_material_benchmark[annual_spend_eur] )
		formatString: #,##0 "€"
		lineageTag: 7f0f76bb-03a5-4354-9955-ee09085575a4

	measure 'Annual Volume (kg)' = SUM ( consolidated_material_benchmark[annual_volume_kg] )
		formatString: #,##0 "kg"
		lineageTag: 0e7f2cf8-cf3d-401e-a9bb-2267aeb5cb09

	measure 'Weighted Avg Price (EUR/kg)' = DIVIDE ( [Annual Spend (EUR)], [Annual Volume (kg)] )
		formatString: 0.00 "€/kg"
		lineageTag: 7dfac4e1-4a9e-4d93-858c-fcdae3d54f80

	measure 'Annual CO2e (kg)' = SUM ( consolidated_material_benchmark[annual_co2e_kg] )
		formatString: #,##0 "kg CO2e"
		lineageTag: dc4820ed-e0dd-4f47-973b-4ac51d7a26eb

	measure 'Weighted Avg PCF (kgCO2e/kg)' =
			VAR RowsWithPCF =
			    FILTER (
			        consolidated_material_benchmark,
			        NOT ISBLANK ( consolidated_material_benchmark[pcf_kgco2e_per_kg] )
			    )
			RETURN
			    DIVIDE (
			        SUMX ( RowsWithPCF, consolidated_material_benchmark[annual_co2e_kg] ),
			        SUMX ( RowsWithPCF, consolidated_material_benchmark[annual_volume_kg] )
			    )
		formatString: 0.00 "kg CO2e/kg"
		lineageTag: f39cccf4-9b0d-4e2e-8d77-eb4f358ef2d4

	measure 'Baseline Spend (EUR)' =
			CALCULATE (
			    [Annual Spend (EUR)],
			    REMOVEFILTERS ( consolidated_material_benchmark ),
			    VALUES ( consolidated_material_benchmark[comparison_case_id] ),
			    consolidated_material_benchmark[sourcing_status] = "Current"
			)
		formatString: #,##0 "€"
		lineageTag: 61d24c9e-05fd-4bb3-ae5e-cd2fdec8c30b

	measure 'Baseline CO2e (kg)' =
			CALCULATE (
			    [Annual CO2e (kg)],
			    REMOVEFILTERS ( consolidated_material_benchmark ),
			    VALUES ( consolidated_material_benchmark[comparison_case_id] ),
			    consolidated_material_benchmark[sourcing_status] = "Current"
			)
		formatString: #,##0 "kg CO2e"
		lineageTag: 4940eb88-da0b-4b34-b181-4f24e7d411b3

	measure 'Cost Delta vs Baseline (EUR)' = [Annual Spend (EUR)] - [Baseline Spend (EUR)]
		formatString: +#,##0 "€";-#,##0 "€";0 "€"
		lineageTag: c74483d4-49d8-450d-9c57-1a79b0cb6705

	measure 'CO2e Delta vs Baseline (kg)' =
			IF (
			    NOT ISBLANK ( [Annual CO2e (kg)] ) && NOT ISBLANK ( [Baseline CO2e (kg)] ),
			    [Annual CO2e (kg)] - [Baseline CO2e (kg)]
			)
		formatString: +#,##0 "kg";-#,##0 "kg";0 "kg"
		lineageTag: 1cbf0b65-5b8a-4f22-b12c-67da1238f8e3

	measure 'Cost Delta %' =
			VAR Base = [Baseline Spend (EUR)]
			RETURN
			    IF (
			        HASONEVALUE ( consolidated_material_benchmark[material_id] ),
			        DIVIDE ( [Annual Spend (EUR)] - Base, Base )
			    )
		formatString: +0.00 %;-0.00 %;0.00 %
		lineageTag: 74b944be-df7a-4a85-a750-ddf81aa47817

	measure 'CO2e Delta %' =
			VAR Cur = [Annual CO2e (kg)]
			VAR Base = [Baseline CO2e (kg)]
			RETURN
			    IF (
			        HASONEVALUE ( consolidated_material_benchmark[material_id] )
			            && NOT ISBLANK ( Cur )
			            && NOT ISBLANK ( Base ),
			        DIVIDE ( Cur - Base, Base )
			    )
		formatString: +0.00 %;-0.00 %;0.00 %
		lineageTag: a32ffd9b-d670-4f20-b1bc-ff357d5a3b58

	measure 'Materials Evaluated' = DISTINCTCOUNT ( consolidated_material_benchmark[material_id] )
		formatString: #,##0
		lineageTag: ec6becc2-ecce-4750-9450-81c630e1fa93

	measure 'Technically Eligible Materials' =
			CALCULATE (
			    [Materials Evaluated],
			    consolidated_material_benchmark[technically_eligible] = TRUE ()
			)
		formatString: #,##0
		lineageTag: d0b57b2b-1687-4821-a117-f1ddcc2a0e1f

	measure 'Technical Eligibility Rate' = DIVIDE ( [Technically Eligible Materials], [Materials Evaluated] )
		formatString: 0.0 %
		lineageTag: 16bb4e7c-3b4b-4a00-868a-799617c8fbd2

	measure 'Materials with PCF' =
			CALCULATE (
			    [Materials Evaluated],
			    consolidated_material_benchmark[has_pcf_data] = TRUE ()
			)
		formatString: #,##0
		lineageTag: 26bd12d5-b2cc-4bce-9c97-c8cfa44b5279

	measure 'PCF Coverage %' = DIVIDE ( [Materials with PCF], [Materials Evaluated] )
		formatString: 0.0 %
		lineageTag: d746fd60-3ec5-4203-9b92-3f52b7c77487

	measure 'Spend Covered by PCF %' =
			DIVIDE (
			    CALCULATE (
			        [Annual Spend (EUR)],
			        consolidated_material_benchmark[has_pcf_data] = TRUE ()
			    ),
			    [Annual Spend (EUR)]
			)
		formatString: 0.0 %
		lineageTag: 3f4cd457-5e8f-409e-8f50-64f950bf7b84

	measure 'High Confidence PCF Materials' =
			CALCULATE (
			    [Materials Evaluated],
			    consolidated_material_benchmark[pcf_data_quality_tier] = "High confidence"
			)
		formatString: #,##0
		lineageTag: 99334a42-c5de-4eb6-b011-e44567bdd231

	measure 'Oldest PCF Reference Year' = MIN ( consolidated_material_benchmark[pcf_reference_year] )
		formatString: 0
		lineageTag: a16d0c13-8eeb-4bb4-b48d-a5e90be88d1e

	measure 'Comparison Cases' = DISTINCTCOUNT ( consolidated_material_benchmark[comparison_case_id] )
		formatString: 0
		lineageTag: 13c10ef3-43b8-4052-b8a6-c4eb07bf96f6

	measure 'Baseline Material' =
			CALCULATE (
			    SELECTEDVALUE ( consolidated_material_benchmark[material_id] ),
			    REMOVEFILTERS ( consolidated_material_benchmark ),
			    VALUES ( consolidated_material_benchmark[comparison_case_id] ),
			    consolidated_material_benchmark[sourcing_status] = "Current"
			)
		lineageTag: abdadd95-deee-46b0-b275-f80bfa7c5cd4

