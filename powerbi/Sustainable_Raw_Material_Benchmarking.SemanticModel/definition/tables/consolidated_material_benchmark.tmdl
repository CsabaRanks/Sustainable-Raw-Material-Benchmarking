	partition consolidated_material_benchmark = m
		mode: import
		source =
				let
				    // The report reads the processed output of src/transform.py.
				    // Point the DataFilePath parameter at your own file; nothing below needs editing.
				    ConfiguredPath = #"DataFilePath",
				    ResolvedPath =
				        if ConfiguredPath = null or Text.Trim(ConfiguredPath) = "" then
				            error "The DataFilePath parameter is empty. Set it to the full path of consolidated_material_benchmark.csv produced by src/transform.py. For the synthetic demonstration this is <repository folder>\data\processed\consolidated_material_benchmark.csv. See docs/POWER_BI_SETUP.md."
				        else
				            Text.Trim(ConfiguredPath),
				    Source = Csv.Document(File.Contents(ResolvedPath), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // The documented output contract, not a column count: extra columns are tolerated,
				    // missing ones fail with a message naming them.
				    RequiredColumns =
				        {
				        "comparison_case_id", "material_group", "material_id",
				        "material_name", "supplier_id", "supplier_name",
				        "supplier_country", "sourcing_status", "annual_volume_kg",
				        "price_eur_per_kg", "currency", "annual_spend_eur",
				        "technical_approval_status", "technically_eligible", "pcf_kgco2e_per_kg",
				        "pcf_data_type", "pcf_reference_year", "pcf_data_quality_tier",
				        "has_pcf_data", "annual_co2e_kg", "cost_delta_vs_baseline_eur",
				        "cost_delta_pct_vs_baseline", "co2e_delta_vs_baseline_kg", "co2e_delta_pct_vs_baseline",
				        "physical_form", "purity_pct", "boiling_point_c",
				        "viscosity_cst", "density_g_cm3", "active_content_pct",
				        "ph_value"
				        },
				    MissingColumns = List.Difference(RequiredColumns, Table.ColumnNames(PromotedHeaders)),
				    ContractChecked =
				        if List.IsEmpty(MissingColumns) then
				            PromotedHeaders
				        else
				            error "The file at """ & ResolvedPath & """ does not match the documented Power BI input contract. Missing required column(s): " & Text.Combine(MissingColumns, ", ") & ". Regenerate it with src/transform.py, or see docs/POWER_BI_INPUT_CONTRACT.md.",
				    TypedColumns = Table.TransformColumnTypes(
				        ContractChecked,
				        {
				            {"annual_volume_kg", Int64.Type},
				            {"price_eur_per_kg", type number},
				            {"annual_spend_eur", type number},
				            {"technically_eligible", type logical},
				            {"pcf_kgco2e_per_kg", type number},
				            {"pcf_reference_year", Int64.Type},
				            {"has_pcf_data", type logical},
				            {"annual_co2e_kg", type number},
				            {"cost_delta_vs_baseline_eur", type number},
				            {"cost_delta_pct_vs_baseline", type number},
				            {"co2e_delta_vs_baseline_kg", type number},
				            {"co2e_delta_pct_vs_baseline", type number},
				            {"purity_pct", type number},
				            {"boiling_point_c", type number},
				            {"viscosity_cst", type number},
				            {"density_g_cm3", type number},
				            {"active_content_pct", type number},
				            {"ph_value", type number}
				        },
				        "en-US"
				    )
				in
				    TypedColumns

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

